rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /players/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && request.resource.data.schema == 1 && request.resource.data.revision == 1 && validHead();
      allow update: if owner(uid) && request.resource.data.revision == resource.data.revision + 1 && validHead();
      allow delete: if false;
      function validHead() {
        return request.resource.data.schema == 1 && request.resource.data.revision is int && request.resource.data.keys().hasOnly(['schema','revision','generation','pages','updatedAt','gameTime'])
          && request.resource.data.generation is string
          && request.resource.data.pages is int && request.resource.data.pages > 0
          && request.resource.data.updatedAt == request.time
          && request.resource.data.gameTime is number;
      }
      match /snapshots/{snapshot} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['payload','generation','createdAt'])
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 700000
          && request.resource.data.generation is string
          && request.resource.data.createdAt == request.time;
        allow update: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
