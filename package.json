{
  "name": "creature-adventure",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node package-build.mjs",
    "test": "vitest run --maxWorkers=1",
    "balance": "node --import tsx balance.ts",
    "preview": "vite preview --host 0.0.0.0",
    "browser": "node --import tsx ui-check.mjs",
    "rules": "firebase emulators:exec --only firestore --project demo-creature-adventure --config firebase-emulator.json \"npm test\"",
    "release:check": "node --import tsx release-check.ts",
    "progression": "node --import tsx progression-check.ts",
    "packaged": "node --import tsx packaged-check.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "break_infinity.js": "^2.2.0",
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.55.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "firebase-tools": "14.27.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
